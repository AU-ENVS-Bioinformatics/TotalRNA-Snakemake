import pandas as pd
from pathlib import Path

configfile: "config/config.yaml"

# --------------------------
# Load samplesheet
# --------------------------
samplesheet = pd.read_csv(
    config["samples_file"],
    sep=r"\s+",
    dtype=str,
    engine="python"
)


samplesheet.columns = samplesheet.columns.str.strip()
samplesheet = samplesheet.set_index("sample_id")

SAMPLES = samplesheet.index.tolist()
SAMPLE_OUTDIR = dict(zip(samplesheet.index, samplesheet["output_dir"]))

OUTDIRS = samplesheet["output_dir"].to_dict()

print(f"samples and out {SAMPLE_OUTDIR}")

# --------------------------
# Helpers
# --------------------------

def raw_r1(wc):
    return samplesheet.loc[wc.sample, "input_files"].split(",")[0]

def raw_r2(wc):
    return samplesheet.loc[wc.sample, "input_files"].split(",")[1]

def sample_out(wc, *paths):
    """Return an output path under the sample-specific output directory."""
    return str(Path(SAMPLE_OUTDIR[wc.sample], wc.sample, *paths))

def outdir_for_sample(wc):
    return SAMPLE_OUTDIR[wc.sample]


# --------------------------
# Modules
# --------------------------
include: "qc/rules/fastqc.smk"
include: "qc/rules/fastp.smk"
include: "qc/rules/kraken2.smk"

# --------------------------
# Final target
# --------------------------
rule QC_done:
    input:
        # FastQC read specific report output
        expand(
            "{outdir}/{sample}/QC/fastqc/{read}",
            zip,
            sample=[s for s in SAMPLES for _ in ("R1", "R2")],
            outdir=[OUTDIRS[s] for s in SAMPLES for _ in ("R1", "R2")],
            read=["R1", "R2"] * len(SAMPLES),
        ),
        # Fastp trimming outputs
        expand(
            "{outdir}/{sample}/QC/trimmed/{sample}_fastp.html",
            zip,
            sample=SAMPLES,
            outdir=[OUTDIRS[s] for s in SAMPLES],
        ),
        # Kraken2 completion
        expand(
            "{outdir}/{sample}/QC/classification/{sample}.kraken",
            zip,
            sample=SAMPLES,
            outdir=[OUTDIRS[s] for s in SAMPLES],
        ),
        # Human contamination decision
        expand(
            "{outdir}/{sample}/QC/classification/{sample}.human.flag",
            zip,
            sample=SAMPLES,
            outdir=[OUTDIRS[s] for s in SAMPLES],
        ),
        # Human decontamination outputs
        expand(
            "{outdir}/{sample}/QC/decontamination/{sample}_R1.clean.fastq.gz",
            zip,
            sample=SAMPLES,
            outdir=[OUTDIRS[s] for s in SAMPLES],
        ),
    output:
        flag="QC/QC.done"
    shell:
        """
        mkdir -p QC
        touch {output.flag}
        """

rule all:
    input:
        "QC/QC.done"

#/usr/bin/time -v seqkit split2 -s 1000000 -e .gz -O split/ -1 trimmed/ANN1_R1_001.fastp.trim.fastq.gz -2 trimmed/ANN1_R2_001.fastp.trim.fastq.gz -j 8 &> split.log