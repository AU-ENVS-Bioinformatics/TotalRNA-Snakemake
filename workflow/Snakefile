configfile: "config/config.yaml"

# --------------------------
# Load samplesheet
# --------------------------
samplesheet = pd.read_csv(
    config["samples_file"],
    sep=r"\s+",
    dtype=str,
    engine="python",
)

samplesheet.columns = samplesheet.columns.str.strip()

required_cols = [
    "sample_id",
    "R1",
    "R2",
]

missing = [
    column
    for column in required_cols
    if column not in samplesheet.columns
]

if missing:
    raise ValueError(
        "Samplesheet is missing required columns: "
        + ", ".join(missing)
    )

samplesheet = samplesheet.set_index("sample_id")

if samplesheet.index.has_duplicates:
    duplicated_samples = (
        samplesheet.index[
            samplesheet.index.duplicated()
        ]
        .unique()
        .tolist()
    )

    raise ValueError(
        "Samplesheet contains duplicated sample IDs: "
        + ", ".join(duplicated_samples)
    )

for sample in samplesheet.index:
    for column in ["R1", "R2"]:
        if pd.isna(samplesheet.loc[sample, column]):
            raise ValueError(
                f"Sample {sample} is missing {column}"
            )


SAMPLES = samplesheet.index.tolist()
print(f"{len(SAMPLES)} samples loaded")

# --------------------------
# PATH HELPERS
# --------------------------

RESULTS_DIR = Path(config["shared_results_dir"])

QC_DIR = RESULTS_DIR / "Quality_Control"
RNA_DIR = RESULTS_DIR / "RNA_Classification"
RNA_CLASSIFIED_DIR = RNA_DIR / "classified"
RNA_INTERMEDIATE_DIR = RNA_DIR / "intermediate"


ASSEMBLY_DIR = str(RESULTS_DIR / "Assembly")
TAXONOMY_DIR = str(RESULTS_DIR / "Taxonomy_Profiling")
QUANT_DIR = str(RESULTS_DIR / "Quantification")
PHYLOGENY_DIR = str(RESULTS_DIR / "Phylogeny")
FUNCTION_DIR = str(RESULTS_DIR / "Functional_Profiling")
VIRAL_ANALYSIS_DIR = str(RESULTS_DIR / "Viral_Sequence_Analysis")
HABITAT_ANALYSIS_DIR = str(RESULTS_DIR / "Habitat_refinement")

#####

validate_taxonomy_config(config)

TAXONOMY_MARKERS = taxonomy_markers(config)

KRAKEN_DATABASES = {
    marker: kraken_database_names(marker, config)
    for marker in TAXONOMY_MARKERS
}

print(f"Taxonomy markers: {TAXONOMY_MARKERS}")
print(f"Taxonomy databases: {KRAKEN_DATABASES}")

# --------------------------
# Helpers (raw reads)
# --------------------------

def raw_r1(wc):
    r1 = samplesheet.loc[wc.sample, "R1"]
    print(f"[INFO] sample: {wc.sample}: read 1 = {r1}")
    return r1

def raw_r2(wc):
    r2 = samplesheet.loc[wc.sample, "R2"]
    print(f"[INFO] sample: {wc.sample}: read 2 = {r2}")
    return r2

def sample_qc_dir(wc):
    return QC_DIR / wc.sample

def rrna_dir(*paths):
    return str(Path(RESULTS_DIR, "rRNA", *paths))

# --------------------------
# SortMeRNA stage logic
# --------------------------

SORTMERNA_STAGES = sortmerna_stages(config)
PREVIOUS_STAGE = previous_stage_map(SORTMERNA_STAGES)

FIRST_STAGE_NAME = SORTMERNA_STAGES[0]
FINAL_STAGE_NAME = SORTMERNA_STAGES[-1]

print(f"sortmerna stages {SORTMERNA_STAGES}")
print(f"previous stage mapping {PREVIOUS_STAGE}")

# --------------------------
# SortMeRNA wrappers (wc-aware)
# --------------------------

def sortmerna_r1(wc):
    return sortmerna_input_r1(
        sample=wc.sample,
        stage=wc.stage,
        results_dir=RESULTS_DIR,
        previous_stage=PREVIOUS_STAGE,
    )


def sortmerna_r2(wc):
    return sortmerna_input_r2(
        sample=wc.sample,
        stage=wc.stage,
        results_dir=RESULTS_DIR,
        previous_stage=PREVIOUS_STAGE,
    )


def sortmerna_db(wc):
    return get_sortmerna_db(wc.stage, config)


def sortmerna_db_idx(wc):
    return get_sortmerna_db_idx(wc.stage, config)

# =========================================================
# Kraken2 wrappers
# =========================================================

def kraken_db(wc):
    return get_kraken_database(
        marker=wc.marker,
        database=wc.database,
        config=config,
    )


def kraken_options(wc):
    return (
        config["taxonomy"][wc.marker]["kraken2"]
        .get("options", "")
    )


def kraken_threads(wc):
    return (
        config["taxonomy"][wc.marker]["kraken2"]
        .get("threads", 2)
    )


def bracken_options(wc):
    return (
        config["taxonomy"][wc.marker]["bracken"]
        .get("options", "")
    )


def bracken_level(wc):
    try:
        return config["taxonomy"][wc.marker][
            "bracken"
        ][wc.database]["level"]

    except KeyError as error:
        available = (
            config["taxonomy"][wc.marker]["bracken"]
            .keys()
        )

        raise ValueError(
            f"No Bracken level configured for "
            f"{wc.marker}/{wc.database}. "
            f"Available entries: {', '.join(available)}"
        ) from error


def biom_options(wc):
    return (
        config["taxonomy"][wc.marker]["kraken_biom"]
        .get("options", "")
    )


def biom_level(wc):
    try:
        return config["taxonomy"][wc.marker][
            "kraken_biom"
        ][wc.database]["level"]

    except KeyError as error:
        raise ValueError(
            f"No kraken-biom level configured for "
            f"{wc.marker}/{wc.database}"
        ) from error


def taxonomy_reports_for_database(wc):
    return taxonomy_reports(
        results_dir=RESULTS_DIR,
        samples=SAMPLES,
        marker=wc.marker,
        database=wc.database,
    )

def habitat_taxonomy_reports_for_database(wc):
    return habitat_taxonomy_reports(
        results_dir=RESULTS_DIR,
        samples=SAMPLES,
        habitat="Soil",
        database=wc.database,
    )

def taxonomy_read_1(wc):
    if wc.marker == "SSU":
        return str(
            RNA_CLASSIFIED_DIR
            / wc.sample
            / "SSU"
            / f"{wc.sample}_SSU_1.fastq.gz"
        )

    if wc.marker == "ITS":
        return str(
            RNA_INTERMEDIATE_DIR
            / wc.sample
            / "ITS_candidates"
            / f"{wc.sample}_ITS_candidates_1.fastq.gz"
        )

    raise ValueError(
        f"Unsupported taxonomy marker '{wc.marker}'"
    )


def taxonomy_read_2(wc):
    if wc.marker == "SSU":
        return str(
            RNA_CLASSIFIED_DIR
            / wc.sample
            / "SSU"
            / f"{wc.sample}_SSU_2.fastq.gz"
        )

    if wc.marker == "ITS":
        return str(
            RNA_INTERMEDIATE_DIR
            / wc.sample
            / "ITS_candidates"
            / f"{wc.sample}_ITS_candidates_2.fastq.gz"
        )

    raise ValueError(
        f"Unsupported taxonomy marker '{wc.marker}'"
    )

