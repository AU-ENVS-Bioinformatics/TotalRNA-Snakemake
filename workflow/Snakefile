# Final workflow target
# =========================================================

rule all:
    input:
        f"{QC_DIR}/quality_control.done",
        f"{RNA_DIR}/rna_classification.done",
        f"{ASSEMBLY_DIR}/reconstruction.done",
        f"{TAXONOMY_DIR}/taxonomy.done",
        f"{PHYLOGENY_DIR}/phylogeny.done",
        f"{FUNCTION_DIR}/functional_profiling.done",
        f"{HABITAT_ANALYSIS_DIR}/habitat_taxonomy.done"

