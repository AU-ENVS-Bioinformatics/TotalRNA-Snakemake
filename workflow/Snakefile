import pandas as pd
import os

configfile: "workflow/config/config.yaml"

# --------------------------
# Load samplesheet
# --------------------------
samplesheet = pd.read_csv(
    config["samples_file"],
    sep=r"\s+",
    dtype=str,
    engine="python"
)

samplesheet.columns = samplesheet.columns.str.strip()
samplesheet = samplesheet.set_index("sample_id")

# --------------------------
# Normalize FASTQ paths ONCE
# --------------------------
samplesheet["input_files"] = (
    samplesheet["input_files"]
    .str.split(",")
    .apply(lambda xs: [x.strip() for x in xs])
)

SAMPLES = samplesheet.index.tolist()
rRNA_SAMPLES = samplesheet[samplesheet["module"] == "rRNA"].index.tolist()

# --------------------------
# Shared helper functions
# --------------------------

def fastqs(sample: str) -> list[str]:
    return samplesheet.loc[sample, "input_files"]

def clean_fq_name(fq: str) -> str:
    base = os.path.basename(fq)
    for ext in (".fastq.gz", ".fq.gz", ".fastq", ".fq"):
        if base.endswith(ext):
            return base[:-len(ext)]
    return base

def sample_root(sample: str) -> str:
    row = samplesheet.loc[sample]
    return f"{row['output_dir']}/{sample}"

def fastqc_input_path(sample: str, readtag: str) -> str:
    fqs = fastqs(sample)

    if len(fqs) == 1:
        if readtag != "SE":
            raise ValueError(f"{sample} is SE but readtag={readtag}")
        return fqs[0]

    if len(fqs) == 2:
        if readtag == "R1":
            return fqs[0]
        if readtag == "R2":
            return fqs[1]
        raise ValueError(f"Invalid readtag {readtag} for {sample}")

    raise ValueError(f"{sample} has {len(fqs)} FASTQs")

def fastqc_outdir(sample: str) -> str:
    return f"{sample_root(sample)}/QC/fastqc"

def fastqc_html(sample: str, readtag: str) -> str:
    fq = fastqc_input_path(sample, readtag)
    return f"{fastqc_outdir(sample)}/{clean_fq_name(fq)}_fastqc.html"

def fastqc_zip(sample: str, readtag: str) -> str:
    fq = fastqc_input_path(sample, readtag)
    return f"{fastqc_outdir(sample)}/{clean_fq_name(fq)}_fastqc.zip"

def fastqc_log(sample: str, readtag: str) -> str:
    return f"{sample_root(sample)}/logs/fastqc_{readtag}.log"

def fastqc_benchmark(sample: str, readtag: str) -> str:
    return f"{sample_root(sample)}/benchmarks/fastqc_{readtag}.txt"


def fastqc_targets():
    for sample, row in samplesheet.iterrows():
        if len(row["input_files"]) == 1:
            yield f"{row['output_dir']}/{sample}/QC/fastqc/SE"
        else:
            yield f"{row['output_dir']}/{sample}/QC/fastqc/R1"
            yield f"{row['output_dir']}/{sample}/QC/fastqc/R2"




# --------------------------
# Modules
# --------------------------
include: "qc/rules/fastqc.smk"

# --------------------------
# Aggregate QC rule
# --------------------------
rule QC_all:
    input:
        list(fastqc_targets())