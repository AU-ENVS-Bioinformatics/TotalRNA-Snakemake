from collections import ChainMap


# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.
configfile: "config/config.yaml"
configfile: "config/private-config.yaml"


shell.prefix("set -o pipefail; ")


module databases:
    snakefile:
        github(
            "AU-ENVS-Bioinformatics/TotalRNA-Snakemake-databases",
            path="workflow/Snakefile",
            branch="main",
        )
    config:
        config


use rule * from databases as databases_*


# ================================================================================
"""Data Preparation Module
=======================
Handles initial data preparation steps:
- Trimming with Trim Galore
- rRNA filtering with SortMeRNA
"""


include: "rules/init.smk"


# ================================================================================
"""
Reconstruction Module and Asssembly
=======================
Handles assembly and reconstruction of both mRNA and rRNA:
- MetaRib reconstruction
- Trinity assembly
"""


rule reconstruction:
    input:
        "results/metarib/final_contigs.fasta",
        "results/trinity/trinity.Trinity.fasta",


include: "rules/metarib.smk"
include: "rules/trinity.smk"


# ================================================================================
"""
Mapping Module
=======================
Handles mapping of reads to contigs for both mRNA and rRNA:
- SAMTOOLS mapping
- BWA mapping
- DuckDB database creation for mapped reads
"""


rule mapping:
    input:
        expand("results/{folder}/database.db", folder=["rRNA", "mRNA"]),


include: "rules/contigs_stats.smk"


# ================================================================================

"""
Non-coding RNA Module
======================
Handles non-coding RNA filtering and processing
"""


rule non_coding_rna_filtering:
    input:
        "results/cmsearch/RFAM_cmsearch_names.txt",


include: "rules/non_coding_RNA.smk"


# ================================================================================

"""
Annotation Module
======================
Handles annotation of contigs:
- CREST4 annotation
- AnnoTree annotation
"""


rule annotation:
    input:
        "results/crest4/mapped_reads_exported_gg.tsv",
        "results/annotree/annotated.tsv",
        "results/eggnog/eggnog_output.tsv",
    output:
        touch("results/annotation.done")

include: "rules/export_tables.smk"
include: "rules/crest4.smk"
include: "rules/annotree.smk"
include: "rules/eggnog.smk"


# ================================================================================


"""
Quality Control Module
=======================
Handles quality control and reporting:
- MultiQC reports
- QUAST assembly quality
- Read count tracking
"""


rule all_qc:
    input:
        "results/qc/trim_galore_multiqc.html",
        "results/qc/sortmerna_SSU_multiqc.html",
        "results/qc/sortmerna_LSU_multiqc.html",
        "results/qc/quast/report.txt",
        "results/qc/counts/sequences_main_steps.pdf",
    output:
        touch("results/all_qc.done")


include: "rules/multiqc.smk"
include: "rules/quast.smk"
include: "rules/qc_read_counts.smk"


rule all:
    input:
        rules.annotation.output,
        rules.all_qc.output