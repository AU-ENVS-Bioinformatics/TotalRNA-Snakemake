import pandas as pd
import re
from pathlib import Path
from typing import Any, List

##################################################################################
############################## INITIAL REQUIREMENTS ##############################
##################################################################################

###########################
### Configuration files ###
###########################

configfile: "config/config.yaml"

RESULTS_DIR: Path = Path(config["shared_results_dir"])

# Validate optional module switches before loading their sections.
MODULE_NAMES = {
    "taxonomy",
    "phylogeny",
    "habitat_refinement",
    "functional_profiling",
    "viral_sequence_analysis",
}

MODULES = config.get("modules", {})

if not isinstance(MODULES, dict):
    raise ValueError(
        "modules must contain module names and true/false values."
    )

for module, enabled in MODULES.items():
    if module not in MODULE_NAMES:
        raise ValueError(f"Unknown module: {module}")

    if not isinstance(enabled, bool):
        raise ValueError(
            f"modules.{module} must be true or false, without quotation marks."
        )

##########################
#### Load samplesheet ####
##########################

samplesheet = pd.read_csv(
    config["samples_file"],
    sep=r"\s+",
    dtype=str,
    engine="python",
)

samplesheet.columns = samplesheet.columns.str.strip()

required_cols = ["sample_id", "R1","R2",]

missing = [column for column in required_cols if column not in samplesheet.columns]

if missing:
    raise ValueError(
        f"Samplesheet is missing required columns: {missing}"
    )

samplesheet = samplesheet.set_index("sample_id")

if samplesheet.index.has_duplicates:
    duplicated_samples = (
        samplesheet.index[
            samplesheet.index.duplicated()
        ]
        .unique()
        .tolist()
    )

    raise ValueError(
        f"Samplesheet contains duplicated sample IDs: {duplicated_samples}"
    )

for sample in samplesheet.index:
    for column in ["R1", "R2"]:
        if pd.isna(samplesheet.loc[sample, column]):
            raise ValueError(
                f"Sample {sample} is missing {column}"
            )


SAMPLES = samplesheet.index.tolist()
print(f"{len(SAMPLES)} samples loaded")

#####################################################################
############################## MODULES ##############################
#####################################################################

#############################################
#### Quality control and decontamination ####
#############################################

# Configuration
configfile: "config/qc_config.yaml"

# Directories
QC_DIR: Path = RESULTS_DIR / "Quality_Control"

# Helpers and completion outputs
from utils.quality_control import (
    raw_r1, 
    raw_r2
)

from targets.quality_control import qc_outputs

# Rules
include: "qc/rules/fastqc.smk"
include: "qc/rules/fastp.smk"
include: "qc/rules/bwa_decontamination.smk"

# Module completion target
rule Quality_Control_done:
    input:
        qc_outputs(QC_DIR, SAMPLES)
    output:
        flag=f"{QC_DIR}/quality_control.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.flag}")"
        touch "{output.flag}"
        """

###############################
##### RNA classification ######
###############################

# Configuration
configfile: "config/rna_classification_config.yaml"

# Directories
RNA_DIR: Path = RESULTS_DIR / "RNA_Classification"
RNA_CLASSIFIED_DIR: Path = RNA_DIR / "classified"
RNA_INTERMEDIATE_DIR: Path = RNA_DIR / "intermediate"

# Helpers and completion outputs
from utils.rna_classification import (
    validate_rna_config,
    sortmerna_stages,
    previous_stage_map,
    sortmerna_r1,
    sortmerna_r2,
    sortmerna_db,
    sortmerna_db_idx,
)

from targets.rna_seperation import rna_outputs

validate_rna_config(config)

if (
    config["RNA_classification"]["method"] == "sortmerna"
    and config["RNA_classification"]["refinement"] == "staged"
):
    SORTMERNA_STAGES = sortmerna_stages(config)
    PREVIOUS_STAGE = previous_stage_map(SORTMERNA_STAGES)

    FIRST_STAGE_NAME = SORTMERNA_STAGES[0]
    FINAL_STAGE_NAME = SORTMERNA_STAGES[-1]

    print(f"SortMeRNA stages: {SORTMERNA_STAGES}")
    print(f"Previous stage mapping: {PREVIOUS_STAGE}")

# Rules
if config["RNA_classification"]["method"] == "sortmerna":

    if config["RNA_classification"]["refinement"] == "staged":
        include: "rna_classification/rules/sortmerna_stages.smk"
        include: "rna_classification/rules/sortmerna_stages_postprocessing.smk"

    elif config["RNA_classification"]["refinement"] == "combined":
        include: "rna_classification/rules/sortmerna_combined.smk"
        include: "rna_classification/rules/sortmerna_combined_postprocessing.smk"
    
    else:
        raise ValueError(
            f"Unsupported SortMeRNA refinement: {config['RNA_classification']['refinement']}"
        )

elif config["RNA_classification"]["method"] == "ribodetector":
    
    include: "rna_classification/rules/ribodetector.smk"

    if config["RNA_classification"]["refinement"] == "bbduk":
        include: "rna_classification/rules/bbduk.smk"

elif config["RNA_classification"]["method"] == "bbmap":
    include: "rna_classification/rules/bbmap.smk"
    include: "rna_classification/rules/bbmap_postprocessing.smk"

else:
    raise ValueError(
        f"Unsupported RNA-separation method: {config['RNA_classification']['method']}"
    )

if config["RNA_classification"]["secondary_method"] == "ITS":
    include: "rna_classification/rules/its_candidates.smk"

# Module completion target
rule RNA_seperation_done:
    input:
        rna_outputs(RNA_DIR,SAMPLES,config)
    output:
        flag=f"{RNA_DIR}/rna_classification.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.flag}")"
        touch "{output.flag}"
        """

###############################
### Sequence reconstruction ###
###############################

# Configuration
configfile: "config/reconstruction.yaml"

# Directories
ASSEMBLY_DIR: Path = RESULTS_DIR / "Assembly"

# Helpers and completion outputs
from utils.reconstruction import (
    validate_reconstruction_config,
    sample_reconstruction_targets,
    concatenation_targets,
    barrnap_kingdoms,
    rnaspades_sample_input,
    prefixed_reconstructed_fastas,
    active_barrnap_kingdoms,
)

from targets.reconstruction import reconstruction_outputs

# Validate configuration
validate_reconstruction_config(config)

# Assembly methods and disable/enable switches

RECONSTRUCTION_METHOD = config["reconstruction"]["method"]

ASSEMBLY_REFINEMENT = config["reconstruction"].get(
    "refinement", "coassembly"
)

if ASSEMBLY_REFINEMENT not in {"coassembly", "samples", "both", "all"}:
    raise ValueError(
        "reconstruction.refinement must be coassembly, samples, both, or all."
    )

COASSEMBLY_ENABLED = ASSEMBLY_REFINEMENT in {
    "coassembly", "both", "all"
}

SAMPLE_ASSEMBLY_ENABLED = ASSEMBLY_REFINEMENT in {
    "samples", "both", "all"
}

SSU_PREDICTION = config["reconstruction"]["ssu_postprocessing"].get(
    "prediction_method", True
)

if not isinstance(SSU_PREDICTION, bool):
    raise ValueError(
        "reconstruction.ssu_postprocessing.prediction_method "
        "must be true or false, without quotation marks."
    )

# Only rnaSPAdes is implemented in this section.
if RECONSTRUCTION_METHOD != "rnaspades":
    raise ValueError(
        f"Unsupported reconstruction method: {RECONSTRUCTION_METHOD}"
    )

# target pattern

SAMPLE_RECONSTRUCTION_TARGETS = sample_reconstruction_targets(config)

SAMPLE_TARGET_PATTERN = "|".join(
    re.escape(target)
    for target in SAMPLE_RECONSTRUCTION_TARGETS
)

COASSEMBLY_TARGETS = config["reconstruction"].get("coassembly_targets", ["non_rRNA"])

if any(target not in {"non_rRNA", "SSU"} for target in COASSEMBLY_TARGETS):
    raise ValueError(
        "reconstruction.coassembly_targets supports non_rRNA and SSU."
    )

if COASSEMBLY_ENABLED and not COASSEMBLY_TARGETS:
    raise ValueError(
        "Select at least one reconstruction.coassembly_targets entry."
    )

CROSS_SAMPLE_TARGET_PATTERN = "|".join(re.escape(target) for target in COASSEMBLY_TARGETS)

CONCATENATION_TARGETS = concatenation_targets(config)

CONCATENATION_TARGET_PATTERN = "|".join(re.escape(target) for target in CONCATENATION_TARGETS)

# dependencies

if SSU_PREDICTION:
    if not SAMPLE_ASSEMBLY_ENABLED:
        raise ValueError(
            "SSU prediction requires reconstruction.refinement "
            "to be samples, both, or all."
        )

    if "SSU" not in SAMPLE_RECONSTRUCTION_TARGETS:
        raise ValueError(
            "SSU prediction requires SSU "
            "in reconstruction.targets."
        )

    BARRNAP_KINGDOMS = barrnap_kingdoms(config)

    BARRNAP_KINGDOM_PATTERN = "|".join(
        re.escape(kingdom)
        for kingdom in BARRNAP_KINGDOMS
    )

# Rules

# Shared assembly input preparation.
include: "reconstruction/rules/preprocessing.smk"

# Cross-sample non-rRNA assembly.
if COASSEMBLY_ENABLED:
    include: "reconstruction/rules/rnaspades.smk"

# Sample-specific SSU / ITS-candidate assemblies.
if SAMPLE_ASSEMBLY_ENABLED:
    include: "reconstruction/rules/rnaspades_samples.smk"

# Shared concatenation rules.
include: "reconstruction/rules/concatenation.smk"

# ITS extraction from sample-specific ITS-candidate assemblies.
if (
    SAMPLE_ASSEMBLY_ENABLED
    and "ITS_candidates" in SAMPLE_RECONSTRUCTION_TARGETS
):
    include: "reconstruction/rules/itsx.smk"

# Optional SSU prediction and postprocessing.
if SSU_PREDICTION:
    include: "reconstruction/rules/barrnap_ssu.smk"
    include: "reconstruction/rules/ssu_postprocessing.smk"

# Module completion target
rule reconstruction_done:
    input:
        lambda wc: reconstruction_outputs(
            results_dir=RESULTS_DIR,
            samples=SAMPLES,
            config=config,
            active_kingdoms=(
                active_barrnap_kingdoms(
                    checkpoints=checkpoints,
                )
                if SSU_PREDICTION
                else []
            ),
        )
    output:
        flag=f"{ASSEMBLY_DIR}/reconstruction.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p $(dirname {output.flag})
        touch {output.flag}
        """

#############################
#### Taxonomic profiling ####
#############################

if MODULES.get("taxonomy", False):
    # Configuration
    configfile: "config/taxonomy.yaml"

    # Directories
    TAXONOMY_DIR: Path = RESULTS_DIR / "Taxonomy_Profiling"
    TAXONOMY_ENVS_DIR: Path = (Path(workflow.basedir) / "taxonomy" / "envs")
    # Helpers and completion outputs
    from targets.taxonomy import taxonomy_outputs

    from utils.taxonomy import (
        validate_taxonomy_config,
        taxonomy_markers,
        kraken_database_names,
        kraken_db,
        taxonomy_read,
        taxonomy_read_1,
        taxonomy_read_2,
        original_ssu_read,
        grouped_ssu_read,
        kraken_options,
        kraken_threads,
        bracken_options,
        bracken_level,
        biom_options,
        biom_level,
        taxonomy_reports_for_database,
        its_blast_regions,
        its_summary_rank
    )

    validate_taxonomy_config(config)

    TAXONOMY_MARKERS = taxonomy_markers(config)

    KRAKEN_DATABASES = {
        marker: kraken_database_names(marker, config)
        for marker in TAXONOMY_MARKERS
    }

    print(f"Taxonomy markers: {TAXONOMY_MARKERS}")
    print(f"Taxonomy databases: {KRAKEN_DATABASES}")

    # Rules

    # Kraken2/Bracken are shared by SSU and ITS.
    include: "taxonomy/rules/kraken.smk"
    include: "taxonomy/rules/bracken.smk"
    include: "taxonomy/rules/kraken_bracken_downstream.smk"

    # Reconstructed ITS/ITSx BLAST taxonomy.
    if "ITS" in TAXONOMY_MARKERS and SAMPLE_ASSEMBLY_ENABLED:
        if "ITS_candidates" not in SAMPLE_RECONSTRUCTION_TARGETS:
            raise ValueError(
                "Assembly-based ITS taxonomy requires ITS_candidates "
                "in reconstruction.targets."
            )

        ITS_REGIONS = its_blast_regions(config)
        ITS_REGION_PATTERN = "|".join(ITS_REGIONS)

        include: "taxonomy/rules/blastn.smk"
        include: "taxonomy/rules/blastn_postprocessing.smk"
        
    # Module completion target

    rule taxonomy_done:
        input:
            taxonomy_outputs(
                results_dir=RESULTS_DIR,
                samples=SAMPLES,
                config=config,
            )
        output:
            flag=f"{TAXONOMY_DIR}/taxonomy.done"
        shell:
            r"""
            set -euo pipefail

            mkdir -p "$(dirname "{output.flag}")"
            touch "{output.flag}"
            """

###############################
#### Phylogenetic analysis ####
###############################

if MODULES.get("phylogeny", False):
    
    if not SSU_PREDICTION:
        raise ValueError(
            "Phylogeny requires reconstruction.ssu_postprocessing.prediction_method: true. Enable SSU prediction or set modules.phylogeny: false."
        )

    # Configuration
    configfile: "config/phylogeny.yaml"

    # Directories
    PHYLOGENY_DIR: Path = RESULTS_DIR / "Phylogeny"

    # Helpers and completion outputs
    from utils.phylogeny import kingdoms_with_blast_hits
    from targets.phylogeny import phylogeny_outputs

    # Rules
    include: "phylogeny/rules/blastn.smk"
    include: "phylogeny/rules/blastn_postprocessing.smk"
    include: "phylogeny/rules/mafft.smk"
    include: "phylogeny/rules/trimal.smk"
    include: "phylogeny/rules/iqtree.smk"

    # Module completion target
    rule Phylogeny_done:
        input:
            lambda wc: phylogeny_outputs(
                results_dir=RESULTS_DIR,
                barrnap_kingdoms=active_barrnap_kingdoms(
                    checkpoints=checkpoints,
                ),
                kingdoms_with_blast_hits=kingdoms_with_blast_hits(
                    checkpoints=checkpoints,
                ),
            )
        output:
            flag=f"{PHYLOGENY_DIR}/phylogeny.done"
        shell:
            r"""
            set -euo pipefail

            mkdir -p $(dirname {output.flag})
            touch {output.flag}
            """

###################################
#### Habitat specific analysis ####
###################################

if MODULES.get("habitat_refinement", False):

    # Required upstream module
    if not MODULES.get("taxonomy", False):
        raise ValueError(
            "Habitat refinement requires modules.taxonomy: true in config/config.yaml."
        )

    # Configuration
    configfile: "config/habitat_refinement.yaml"

    # Directories
    HABITAT_ANALYSIS_DIR: Path = RESULTS_DIR / "Habitat_refinement"

    HABITAT_ENVS_DIR: Path = (
        Path(workflow.basedir) / "taxonomy" / "envs"
    )

    # Helpers and completion outputs
    from utils.habitats import (
        selected_habitat,
        habitat_database_names,
        validate_habitat_config,
        habitat_kraken_db,
        habitat_kraken_options,
        habitat_kraken_threads,
        habitat_bracken_options,
        habitat_bracken_level,
        habitat_biom_options,
        habitat_biom_level,
        habitat_reports_for_database,
        habitat_read_1,
        habitat_read_2,
    )

    from targets.habitats import habitat_refinement_outputs

    # Validate and initialize
    validate_habitat_config(config)

    SELECTED_HABITAT = selected_habitat(config)

    if SELECTED_HABITAT is None:
        raise ValueError(
            "modules.habitat_refinement is true, but Habitat_refinement.habitat is 'none'. Select Soil or Glacier in config/habitat_refinement.yaml."
        )

    if ("SSU" not in TAXONOMY_MARKERS or "silva" not in KRAKEN_DATABASES.get("SSU", [])):
        raise ValueError(
            "Habitat refinement requires the SSU taxonomy branch "
            "with database 'silva' in config/taxonomy.yaml."
        )

    HABITAT_DATABASES = habitat_database_names(
        habitat=SELECTED_HABITAT,
        config=config,
    )

    print(f"Habitat refinement: {SELECTED_HABITAT}")
    print(f"Habitat databases: {HABITAT_DATABASES}")

    # Rules
    if SELECTED_HABITAT == "Glacier":
        include: "habitat_refinement/rules/Preprocess_habitat_taxonomy.smk"

    include: "habitat_refinement/rules/habitat_kraken.smk"
    include: "habitat_refinement/rules/habitat_bracken.smk"
    include: "habitat_refinement/rules/habitat_bracken_downstream.smk"

    # Module completion target
    rule habitat_refinement_done:
        input:
            habitat_refinement_outputs(
                results_dir=RESULTS_DIR,
                samples=SAMPLES,
                config=config,
            )
        output:
            flag=f"{HABITAT_ANALYSIS_DIR}/habitat_refinement.done"
        shell:
            r"""
            set -euo pipefail

            mkdir -p $(dirname {output.flag})
            touch {output.flag}
            """

###################################
##### Functional profiling ########
###################################

if MODULES.get("functional_profiling", False):
    # Configuration
    configfile: "config/functional_profiling.yaml"

    # Directories
    FUNCTION_DIR: Path = RESULTS_DIR / "Functional_Profiling"
    FUNCTION_DIR_ASM: Path = FUNCTION_DIR / "assembly_based"
    FUNCTION_DIR_READS: Path = FUNCTION_DIR / "read_based"

    FUNCTIONAL_SCRIPTS_DIR: Path = (
        Path(workflow.basedir) / "functional_profiling" / "scripts"
    )

    ORF_DIR: Path = FUNCTION_DIR / "ORF_prediction"

    TRANSDECODER_WORK_DIR: Path = ORF_DIR / "transdecoder/work"
    TRANSDECODER_LONGORFS_DIR: Path = ORF_DIR / "transdecoder/longorfs"
    TRANSDECODER_PREDICT_DIR: Path = ORF_DIR / "transdecoder/predict"

    HUMANN_MERGED_DIR: Path = FUNCTION_DIR_READS / "humann_merged"
    HUMANN_JOIN_DIR: Path = HUMANN_MERGED_DIR / "humann_link_input"

    # Helpers and completion outputs
    from utils.functional_profiling import (
        SALMON_REFERENCES,
        SALMON_METRICS,
        validate_functional_config,
        read_based_enabled,
        assembly_based_enabled,
        final_orf_sources,
        salmon_reference,
        get_hmmscan_outputs,
    )

    from targets.functional_profiling import functional_profiling_outputs

    # Validate and initialize
    validate_functional_config(config)

    FUNCTIONAL_MODULE = config["functional_profiling"]["module"]

    # Retained for your existing viral dependency checks.
    functional_module = FUNCTIONAL_MODULE

    READ_BASED_ENABLED = read_based_enabled(config)
    ASSEMBLY_BASED_ENABLED = assembly_based_enabled(config)

    if ASSEMBLY_BASED_ENABLED and not COASSEMBLY_ENABLED:
        raise ValueError(
            "Assembly-based functional profiling requires reconstruction.refinement to be coassembly, both, or all."
        )

    SALMON_REFERENCE_PATTERN = "|".join(SALMON_REFERENCES)
    SALMON_METRIC_PATTERN = "|".join(SALMON_METRICS)

    # Rules: read-based profiling
    if READ_BASED_ENABLED:
        include: "functional_profiling/rules/metaphlan.smk"

        if config["functional_profiling"]["read_method"] == "humann":
            include: "functional_profiling/rules/humann.smk"
            include: "functional_profiling/rules/humann_postprocessing.smk"

    # Rules: assembly-based profiling
    if ASSEMBLY_BASED_ENABLED:
        ORF_PREDICTOR = config["functional_profiling"]["ORF_predictor"]

        ASSEMBLED_NONRRNA = (f"{ASSEMBLY_DIR}/coassembly/non_rRNA/rnaspades/transcripts.fasta")

        FINAL_ORF_SOURCES = final_orf_sources(
            results_dir=RESULTS_DIR,
            config=config,
        )

        FINAL_ORF_PROTEINS = FINAL_ORF_SOURCES["proteins"]
        FINAL_ORF_GENES = FINAL_ORF_SOURCES["genes"]
        FINAL_ORF_GFF = FINAL_ORF_SOURCES["gff"]

        if ORF_PREDICTOR == "prodigal":
            include: "functional_profiling/rules/prodigal.smk"

        elif ORF_PREDICTOR == "transdecoder":
            include: "functional_profiling/rules/transdecoder.smk"
            include: "functional_profiling/rules/diamond.smk"
            include: "functional_profiling/rules/hmmscan.smk"
            include: "functional_profiling/rules/hmmscan_processing.smk"

        include: "functional_profiling/rules/publish_orf.smk"
        include: "functional_profiling/rules/eggnog.smk"
        include: "functional_profiling/rules/salmon.smk"
        include: "functional_profiling/rules/Abundance_Matrix.smk"

    # Module completion target
    rule functional_profiling_done:
        input:
            functional_profiling_outputs(
                results_dir=RESULTS_DIR,
                samples=SAMPLES,
                config=config,
            )
        output:
            flag=f"{FUNCTION_DIR}/functional_profiling.done"
        shell:
            r"""
            set -euo pipefail

            mkdir -p $(dirname {output.flag})
            touch {output.flag}
            """

#######################################
