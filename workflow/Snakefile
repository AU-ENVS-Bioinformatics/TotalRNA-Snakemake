if MODULES.get("viral_sequence_analysis", False):

    # Configuration
    configfile: "config/viral_sequence_analysis.yaml"

    # Directories
    VIRAL_ANALYSIS_DIR: Path = RESULTS_DIR / "Viral_Sequence_Analysis"

    VIRAL_SCRIPT_DIR: Path = (
        Path(workflow.basedir)
        / "viral_sequence_analysis"
        / "scripts"
    )

    # Helpers and completion outputs
    from utils.viral_sequence_analysis import validate_viral_config
    from targets.viral_sequence_analysis import viral_output

    # Validate and initialize
    VIRAL_POSTPROCESSING = config["viral_sequence_analysis"].get(
        "postprocessing", True
    )

    if (
        VIRAL_POSTPROCESSING and not MODULES.get("functional_profiling", False)
    ):
        raise ValueError(
            "Viral postprocessing requires "
            "modules.functional_profiling: true in config/config.yaml."
        )

    # Checks assembly-based profiling and TransDecoder requirements.
    validate_viral_config(config)

    # Rules
    include: "viral_sequence_analysis/rules/prefilter.smk"
    include: "viral_sequence_analysis/rules/geNomad.smk"
    include: "viral_sequence_analysis/rules/checkv.smk"

    if VIRAL_POSTPROCESSING:
        include: "viral_sequence_analysis/rules/postprocessing.smk"

    # Module completion target
    rule viral_sequence_analysis_done:
        input:
            viral_output(
                results_dir=RESULTS_DIR,
                samples=SAMPLES,
                config=config,
            )
        output:
            flag=f"{VIRAL_ANALYSIS_DIR}/viral_sequence_analysis.done"
        shell:
            r"""
            set -euo pipefail

            mkdir -p $(dirname {output.flag})
            touch {output.flag}
            """
        
######################################
###### FINAL WORKFLOW TARGETS ########
######################################

# Mandatory modules
FINAL_TARGETS = [
    f"{QC_DIR}/quality_control.done",
    f"{RNA_DIR}/rna_classification.done",
    f"{ASSEMBLY_DIR}/reconstruction.done",
]


# Optional modules
OPTIONAL_TARGETS = {
    "taxonomy": (
        f"{RESULTS_DIR}/Taxonomy_Profiling/taxonomy.done"
    ),
    "phylogeny": (
        f"{RESULTS_DIR}/Phylogeny/phylogeny.done"
    ),
    "habitat_refinement": (
        f"{RESULTS_DIR}/Habitat_refinement/habitat_refinement.done"
    ),
    "functional_profiling": (
        f"{RESULTS_DIR}/Functional_Profiling/functional_profiling.done"
    ),
    "viral_sequence_analysis": (
        f"{RESULTS_DIR}/Viral_Sequence_Analysis/viral_sequence_analysis.done"
    ),
}

MODULES = config.get("modules", {})

if not isinstance(MODULES, dict):
    raise ValueError("modules must contain module names and true/false values.")

for module, enabled in MODULES.items():
    if module not in OPTIONAL_TARGETS:
        raise ValueError(f"Unknown module: {module}")

    if not isinstance(enabled, bool):
        raise ValueError(
            f"modules.{module} must be true or false, without quotation marks."
        )

if MODULES.get("habitat_refinement", False) and SELECTED_HABITAT is None:
    raise ValueError(
        "Habitat refinement is requested, but Habitat_refinement.habitat is 'none'."
    )

for module, target in OPTIONAL_TARGETS.items():
    if MODULES.get(module, False):
        FINAL_TARGETS.append(target)

rule all:
    default_target: True
    input:
