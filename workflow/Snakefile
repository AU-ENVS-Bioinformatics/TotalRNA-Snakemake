import pandas as pd
from pathlib import Path

configfile: "config/config.yaml"

# --------------------------
# Load samplesheet
# --------------------------…
samplesheet = pd.read_csv(
    config["samples_file"],
    sep=r"\s+",
    dtype=str,
    engine="python"
)

samplesheet.columns = samplesheet.columns.str.strip()
samplesheet = samplesheet.set_index("sample_id")

SAMPLES = samplesheet.index.tolist()

RESULTS_DIR = Path(config["shared_results_dir"])

NO_SAMPLES = len(SAMPLES)

print(f"{NO_SAMPLES} samples loaded")
print(f"Shared results directory: {RESULTS_DIR}")

# --------------------------
# Helpers
# --------------------------

def raw_r1(wc):
    return samplesheet.loc[wc.sample, "input_files"].split(",")[0]

def raw_r2(wc):
    return samplesheet.loc[wc.sample, "input_files"].split(",")[1]

def sample_qc_dir(wc):
    return RESULTS_DIR / "qc" / wc.sample

def rrna_dir(*paths):
    return str(Path(RESULTS_DIR, "rRNA", *paths))

# --------------------------
# sortmeRNA stage logic
# --------------------------

def sortmerna_stages():
    """
    ['ssu', 'lsu'] -> ['ssu', 'ssu_lsu']
    """
    base = config["qc"]["sortmerna"]["pipeline"]
    return ["_".join(base[:i + 1]) for i in range(len(base))]

SORTMERNA_STAGES = sortmerna_stages()

PREVIOUS_STAGE = {
    SORTMERNA_STAGES[0]: "decontamination",
    **{
        SORTMERNA_STAGES[i]: SORTMERNA_STAGES[i - 1]
        for i in range(1, len(SORTMERNA_STAGES))
    },
}

FIRST_SORTMERNA_STAGE = [SORTMERNA_STAGES[0] for i in range(len(SAMPLES))]
FINAL_SORTMERNA_STAGE = [SORTMERNA_STAGES[-1] for i in range(len(SAMPLES))]


print(f"sortmerna stages {SORTMERNA_STAGES} with previous stages {PREVIOUS_STAGE} and final stage {FINAL_SORTMERNA_STAGE} to be requested to trigger previous stages in the workflow")
# sortmerna stages ['ssu', 'ssu_lsu'] with previous stages {'ssu': 'decontamination', 'ssu_lsu': 'ssu'} with final stages being identical ['ssu_lsu', 'ssu_lsu'] for the samples

# --------------------------
# sortmeRNA helper paths
# --------------------------

def sortmerna_r1(wc):
    qc_base = RESULTS_DIR / "qc" / wc.sample
    rna_base = RESULTS_DIR / "RNA" / wc.sample

    prev = PREVIOUS_STAGE[wc.stage]

    if prev == "decontamination":
        return str(
            qc_base/"decontamination"/f"{wc.sample}_R1.cleaned.fastq.gz"
        )

    return str(
        rna_base/"sortmerna"/prev/f"{wc.sample}_{prev}.nonaligned_fwd.fq.gz"
    )

def sortmerna_r2(wc):
    qc_base = RESULTS_DIR / "qc" / wc.sample
    rna_base = RESULTS_DIR / "RNA" / wc.sample

    prev = PREVIOUS_STAGE[wc.stage]

    if prev == "decontamination":
        return str(
            qc_base / "decontamination" / f"{wc.sample}_R2.cleaned.fastq.gz"
        )

    return str(
        rna_base / "sortmerna" / prev / f"{wc.sample}_{prev}.nonaligned_rev.fq.gz"
    )

def sortmerna_db(wc):
    key = wc.stage.split("_")[-1]
    return config["databases"][f"sortmeRNA_{key}"]

def sortmerna_db_idx(wc):
    key = wc.stage.split("_")[-1]
    return config["databases"][f"sortmeRNA_{key}_idx"]

# --------------------------
# Final target
# --------------------------

rule all:
    input:
        f"{RESULTS_DIR}/qc/QC.done",
        f"{RESULTS_DIR}/rRNA/rRNA.done"

# --------------------------
# Modules
# --------------------------
include: "qc/rules/fastqc.smk"
include: "qc/rules/fastp.smk"
include: "qc/rules/kraken2.smk"
include: "qc/rules/bwa_decontamination.smk"
include: "qc/rules/sortmerna.smk"

include: "rRNA/rules/qiime2.smk"
# --------------------------
# Final target
# --------------------------
rule QC_done:
    input:
        # FastQC read specific report output
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/fastqc/{{read}}",
            zip,
            sample=[s for s in SAMPLES for _ in ("R1", "R2")],
            read=["R1", "R2"] * len(SAMPLES),
        ),
        # Fastp trimming outputs
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/trimmed/{{sample}}_fastp.html",
            zip,
            sample=SAMPLES,
        ),
        # Kraken2 report of contamination sources
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/classification/{{sample}}.kraken",
            zip,
            sample=SAMPLES
        ),
        # BWA-mem2 Aligned contaminants genomes 
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/decontamination/{{sample}}_aligned_contaminants.sam",
            zip,
            sample=SAMPLES,
        ),
        # Identify read IDs of contaminants
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/decontamination/{{sample}}_contaminants_id.txt",
            zip,
            sample=SAMPLES
        ),
        # Decontamination of reads
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/decontamination/{{sample}}_R1.cleaned.fastq.gz",
            zip,
            sample=SAMPLES,
        ),
    output:
        flag=f"{RESULTS_DIR}/qc/QC.done"
    shell:
        """
        mkdir -p qc
        touch {output.flag}
        """

rule RNA_seperation_done:
    input:
        # SortmeRNA on defined stages defined like a chain: Decontaminated reads -> SSU aligned reads -> SSU non-aligned reads -> LSU aligned reads -> LSU non-aligned reads, and so on if more stages are added in the config pipeline definition. By defining the stages as a chain, we can ensure that the stages are run in order, and we can also easily add more stages or change the order of the stages by simply changing the definition of the stages and the previous stage mapping.
        expand(
            f"{RESULTS_DIR}/RNA/{{sample}}/sortmerna/{{stage}}/{{sample}}_{{stage}}.aligned_fwd.fq.gz",
            zip, # we need zip to ensure each stage maps to each sample output, otherwise it would run each stage for each sample for each sample output (so not sample specific sample output, from samplesheet), so cartesian multiplication
            sample=SAMPLES,
            stage=FINAL_SORTMERNA_STAGE, #Define last step in the chain, this way snakemake itself will activate the dependencies (previous steps in the chain).
        )
    output:
        flag=f"{RESULTS_DIR}/RNA/RNA_seperation.done"
    shell:
        """
        mkdir -p qc
        touch {output.flag}
        """

rule rRNA_done:
    input:
        expand(
            f"{RESULTS_DIR}/rRNA/qiime/{{stage}}/qiime_{{stage}}_manifest.csv",
            stage=SORTMERNA_STAGES,
        ),
        expand(
            f"{RESULTS_DIR}/rRNA/qiime/{{stage}}/qiime_{{stage}}_demux.qza",
            stage=SORTMERNA_STAGES,
        )
    output:
        flag=f"{RESULTS_DIR}/rRNA/rRNA.done"
    shell:
        """
        mkdir -p rRNA
        touch {output.flag}
        """

