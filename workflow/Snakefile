import pandas as pd
import re
from pathlib import Path

from targets.quality_control import qc_outputs

from targets.rna_seperation import (
    rna_outputs,
    sortmerna_stages,
    previous_stage_map,
    sortmerna_input_r1,
    sortmerna_input_r2,
    get_sortmerna_db,
    get_sortmerna_db_idx,
)

from targets.reconstruction import reconstruction_outputs

from targets.rrna import (
    rrna_outputs,
    kraken_database_names,
    get_kraken_database,
    taxonomy_reports,
)

from targets.phylogeny import phylogeny_outputs

from targets.nonrrna import non_rrna_outputs

configfile: "config/config.yaml"

# --------------------------
# Load samplesheet
# --------------------------
samplesheet = pd.read_csv(
    config["samples_file"],
    sep=r"\s+",
    dtype=str,
    engine="python",
)

samplesheet.columns = samplesheet.columns.str.strip()

required_cols = [
    "sample_id",
    "R1",
    "R2",
]

missing = [
    column
    for column in required_cols
    if column not in samplesheet.columns
]

if missing:
    raise ValueError(
        "Samplesheet is missing required columns: "
        + ", ".join(missing)
    )

samplesheet = samplesheet.set_index("sample_id")

if samplesheet.index.has_duplicates:
    duplicated_samples = (
        samplesheet.index[
            samplesheet.index.duplicated()
        ]
        .unique()
        .tolist()
    )

    raise ValueError(
        "Samplesheet contains duplicated sample IDs: "
        + ", ".join(duplicated_samples)
    )

for sample in samplesheet.index:
    for column in ["R1", "R2"]:
        if pd.isna(samplesheet.loc[sample, column]):
            raise ValueError(
                f"Sample {sample} is missing {column}"
            )


SAMPLES = samplesheet.index.tolist()
print(f"{len(SAMPLES)} samples loaded")

# --------------------------
# PATH HELPERS
# --------------------------

RESULTS_DIR = Path(config["shared_results_dir"])

QC_DIR = RESULTS_DIR / "Quality_Control"
RNA_DIR = RESULTS_DIR / "RNA_Classification"
RNA_CLASSIFIED_DIR = RNA_DIR / "classified"
RNA_INTERMEDIATE_DIR = RNA_DIR / "intermediate"


ASSEMBLY_DIR = str(RESULTS_DIR / "Assembly")
TAXONOMY_DIR = str(RESULTS_DIR / "Taxonomy_Profiling")
FUNCTION_DIR = str(RESULTS_DIR / "Functional_Profiling")
QUANT_DIR = str(RESULTS_DIR / "Quantification")
PHYLOGENY_DIR = str(RESULTS_DIR / "Phylogeny")

#####

KRAKEN_DATABASES = kraken_database_names(config)

print(f"Shared results directory: {RESULTS_DIR}")
print(f"Shared results directory: {RESULTS_DIR}")
print(f"Kraken2 databases: {KRAKEN_DATABASES}")

# --------------------------
# Helpers (raw reads)
# --------------------------

def raw_r1(wc):
    r1 = samplesheet.loc[wc.sample, "R1"]
    print(f"[INFO] sample: {wc.sample}: read 1 = {r1}")
    return r1

def raw_r2(wc):
    r2 = samplesheet.loc[wc.sample, "R2"]
    print(f"[INFO] sample: {wc.sample}: read 2 = {r2}")
    return r2

def sample_qc_dir(wc):
    return QC_DIR / wc.sample

def rrna_dir(*paths):
    return str(Path(RESULTS_DIR, "rRNA", *paths))

# --------------------------
# SortMeRNA stage logic
# --------------------------

SORTMERNA_STAGES = sortmerna_stages(config)
PREVIOUS_STAGE = previous_stage_map(SORTMERNA_STAGES)

FIRST_STAGE_NAME = SORTMERNA_STAGES[0]
FINAL_STAGE_NAME = SORTMERNA_STAGES[-1]

print(f"sortmerna stages {SORTMERNA_STAGES}")
print(f"previous stage mapping {PREVIOUS_STAGE}")

# --------------------------
# SortMeRNA wrappers (wc-aware)
# --------------------------

def sortmerna_r1(wc):
    return sortmerna_input_r1(
        sample=wc.sample,
        stage=wc.stage,
        results_dir=RESULTS_DIR,
        previous_stage=PREVIOUS_STAGE,
    )


def sortmerna_r2(wc):
    return sortmerna_input_r2(
        sample=wc.sample,
        stage=wc.stage,
        results_dir=RESULTS_DIR,
        previous_stage=PREVIOUS_STAGE,
    )


def sortmerna_db(wc):
    return get_sortmerna_db(wc.stage, config)


def sortmerna_db_idx(wc):
    return get_sortmerna_db_idx(wc.stage, config)

# =========================================================
# Kraken2 wrappers
# =========================================================

def kraken_db(wc):
    """
    Return the Kraken2 database path corresponding to
    the {database} wildcard.
    """

    return get_kraken_database(
        database=wc.database,
        config=config,
    )


def taxonomy_reports_for_database(wc):
    """
    Return all reports for one Kraken2 database.

    SILVA:
        Bracken reports are returned.

    PR2:
        Raw Kraken2 reports are returned.
    """

    return taxonomy_reports(
        results_dir=RESULTS_DIR,
        samples=SAMPLES,
        database=wc.database,
        config=config,
    )

# =========================================================
# Final workflow target
# =========================================================

rule all:
    input:
        f"{QC_DIR}/qualit_control.done",
        f"{RNA_DIR}/rna_classification.done",
        f"{ASSEMBLY_DIR}/reconstruction.done"
        f"{TAXONOMY_DIR}/taxonomy.done",
        f"{RESULTS_DIR}/phylogeny/phylogeny.done",
        f"{RESULTS_DIR}/nonrRNA/nonrRNA.done"

# =========================================================
# Quality-control module
# =========================================================

### Quality control and decontamination
include: "qc/rules/fastqc.smk"
include: "qc/rules/fastp.smk"
include: "qc/rules/bwa_decontamination.smk"

# =========================================================
# RNA-separation module
# =========================================================

### RNA SEPERATION - check if the if statements are redundant with the ones in the included rules (smk files) or if they are needed to avoid including rules that would not be used
if config["RNA"]["method"] == "sortmerna":

    if config["RNA"]["refinement"] == "staged":
        include: "RNA/rules/sortmerna_stages.smk"
        include: "RNA/rules/sortmerna_stages_postprocessing.smk"
        if config["RNA"]["sortmerna_staged"]["pipeline"] != ["ssu", "lsu"]:
            raise ValueError(
                "The current staged SortMeRNA postprocessing "
                "requires pipeline: [ssu, lsu]"
            )

    elif config["RNA"]["refinement"] == "combined":
        include: "RNA/rules/sortmerna_combined.smk"
        include: "RNA/rules/sortmerna_combined_postprocessing.smk"
    
    else:
        raise ValueError(
            "Unsupported SortMeRNA refinement: "
            f"{config['RNA']['refinement']}"
        )

elif config["RNA"]["method"] == "ribodetector":
    
    include: "RNA/rules/ribodetector.smk"

    if config["RNA"]["refinement"] == "bbduk":
        include: "RNA/rules/bbduk.smk"

elif config["RNA"]["method"] == "bbmap":
    
    include: "RNA/rules/bbmap.smk"
    include: "RNA/rules/bbmap_postprocessing.smk"

else:
    raise ValueError(
        "Unsupported RNA-separation method: "
        f"{config['RNA']['method']}"
    )


if config["RNA"]["secondary_method"] == "ITS":
    include: "RNA/rules/its_candidates.smk"

# =========================================================
# Reconstruction module
# =========================================================

### Quality control and decontamination
include: "reconstruction/rules/preprocessing.smk"
include: "reconstruction/rules/rnaspades.smk"
include: "reconstruction/rules/ITS_concatenation.smk"
include: "reconstruction/rules/itsx.smk"

# =========================================================
# SSU rRNA taxonomic classification
# =========================================================

include: "rRNA/rules/kraken.smk"
include: "rRNA/rules/bracken.smk"
include: "rRNA/rules/kraken_bracken_downstream.smk"

# =========================================================
# SSU rRNA reconstruction and phylogeny
# =========================================================

include: "phylogeny/rules/blastn.smk"
include: "phylogeny/rules/blastn_postprocessing.smk"
include: "phylogeny/rules/mafft.smk"
include: "phylogeny/rules/trimal.smk"
include: "phylogeny/rules/iqtree.smk"

# =========================================================
# Non-rRNA module
# =========================================================

### non-rRNA read-based functional profiling / ORF functional annotation
include: "nonrRNA/rules/preprocessing.smk"

nonrrna_module = config["nonrRNA"]["nonrrna_module"]

if nonrrna_module in ["read", "both", "all"]:

    if config["nonrRNA"]["read_method"] in ["metaphlan", "humann"]:
        # Metaphlan is ALWAYS required (taxonomy baseline)
        include: "nonrRNA/rules/metaphlan.smk"
        # HUMANN is ALWAYS downstream of metaphlan in your design
        include: "nonrRNA/rules/humann.smk"
        include: "nonrRNA/rules/humann_postprocessing.smk"

if nonrrna_module in ["coassembly", "both", "all"]:
    if config["nonrRNA"]["assembly_method"] in ["spades","rnaspades"]:
        # Co assembly
        include: "nonrRNA/rules/co_assembly.smk"
    if config["nonrRNA"]["assembly_predictor"] in ["transdecoder"]:
        include: "nonrRNA/rules/diamond.smk"
        include: "nonrRNA/rules/hmmscan.smk"
        include: "nonrRNA/rules/hmmscan_processing.smk"
        include: "nonrRNA/rules/ORF_prediction.smk" #for now we need ORF_prediction no matter what - NB! consider moving this out to sample specific assembly if this is introduced
    include: "nonrRNA/rules/salmon.smk"
    include: "nonrRNA/rules/eggnog.smk"

if nonrrna_module not in ["read", "coassembly", "both", "all"]:
    raise ValueError(f"Unsupported nonrRNA module: {nonrrna_module}")

# =========================================================
# Module completion targets
# =========================================================

rule Quality_Control_done:
    input:
        qc_outputs(QC_DIR, SAMPLES)
    output:
        flag=f"{QC_DIR}/qualit_control.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.flag}")"
        touch "{output.flag}"
        """

rule RNA_seperation_done:
    input:
        rna_outputs(RNA_DIR,SAMPLES,config)
    output:
        flag=f"{RNA_DIR}/rna_classification.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.flag}")"
        touch "{output.flag}"
        """

rule reconstruction_done:
    input:
        reconstruction_outputs(RESULTS_DIR, SAMPLES,config)
    output:
        flag=f"{ASSEMBLY_DIR}/reconstruction.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.flag}")"
        touch "{output.flag}"
        """

rule taxonomy_done:
    input:
        rrna_outputs(RESULTS_DIR, SAMPLES,config)
    output:
        flag=f"{TAXONOMY_DIR}/taxonomy.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.flag}")"
        touch "{output.flag}"
        """

rule Phylogeny_done:
    input:
        phylogeny_outputs(RESULTS_DIR, SAMPLES,config)
    output:
        flag=f"{RESULTS_DIR}/phylogeny/phylogeny.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.flag}")"
        touch "{output.flag}"
        """

rule nonrRNA_done:
    input:
        non_rrna_outputs(RESULTS_DIR,SAMPLES,config)
    output:
        flag=f"{RESULTS_DIR}/nonrRNA/nonrRNA.done"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.flag}")"
        touch "{output.flag}"
        """

