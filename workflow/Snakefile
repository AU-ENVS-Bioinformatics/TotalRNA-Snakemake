rule QC_done:
    input:
        # FastQC read specific report output
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/fastqc/{{read}}",
            zip,
            sample=[s for s in SAMPLES for _ in ("R1", "R2")],
            read=["R1", "R2"] * len(SAMPLES),
        ),
        # Fastp trimming outputs
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/trimmed/{{sample}}_fastp.html",
            zip,
            sample=SAMPLES,
        ),
        # BWA-mem2 Aligned contaminants genomes 
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/decontamination/{{sample}}_aligned_contaminants.sam",
            zip,
            sample=SAMPLES,
        ),
        # Identify read IDs of contaminants
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/decontamination/{{sample}}_contaminants_id.txt",
            zip,
            sample=SAMPLES
        ),
        # Decontamination of reads
        expand(
            f"{RESULTS_DIR}/qc/{{sample}}/decontamination/{{sample}}_R1.cleaned.fastq.gz",
            zip,
            sample=SAMPLES,
        ),
    output:
        flag=f"{RESULTS_DIR}/qc/QC.done"
    shell:
        """
        mkdir -p {RESULTS_DIR}/qc
        touch {output.flag}
        """

rule RNA_seperation_done:
    input:
        RNA_separation_module()
    output:
        flag=f"{RESULTS_DIR}/RNA/RNA_seperation.done"
    shell:
        """
        mkdir -p {RESULTS_DIR}/RNA
        touch {output.flag}
        """

